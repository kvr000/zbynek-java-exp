<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.github.kvr000.exp.java.quarkus</groupId>
	<artifactId>quarkus-secure-field</artifactId>
	<version>0.0.1</version>
	<packaging>jar</packaging>
	<name>Quarkus secure field experiment</name>
	<description>Field level security on REST entities: @SecureField for reading, @SecureWriteField for writing</description>

	<parent>
		<groupId>com.github.kvr000.exp.java.quarkus</groupId>
		<artifactId>quarkus-exp-base</artifactId>
		<version>0.0.1</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<properties>
		<!-- standalone server: java -jar target/quarkus-secure-field-0.0.1-runner.jar ; lambda profile switches to fast-jar -->
		<quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
		<!-- -Dlambda.skip skips the nested Lambda build -->
		<lambda.skip>false</lambda.skip>
	</properties>

	<build>
		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<parameters>true</parameters>
					<!-- explicit, as JDK 23+ no longer runs processors found on classpath -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!-- parallel execution from parent does not work with @QuarkusTest -->
				<configuration combine.self="override">
					<systemPropertyVariables>
						<java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
						<maven.home>${maven.home}</maven.home>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- builds target/quarkus-app/ (dev/fast-jar) or the uber jar, see quarkus.package.jar.type in application.properties -->
			<plugin>
				<groupId>io.quarkus.platform</groupId>
				<artifactId>quarkus-maven-plugin</artifactId>
				<extensions>true</extensions>
				<executions>
					<execution>
						<goals>
							<goal>build</goal>
							<goal>generate-code</goal>
							<goal>generate-code-tests</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

	<dependencies>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>

		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-arc</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-rest</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-rest-jackson</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-rest-qute</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-smallrye-jwt</artifactId>
		</dependency>
		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-smallrye-jwt-build</artifactId>
		</dependency>

		<dependency>
			<groupId>net.dryuf</groupId>
			<artifactId>dryuf-jackson</artifactId>
		</dependency>
		<dependency>
			<groupId>net.dryuf</groupId>
			<artifactId>dryuf-quarkus</artifactId>
		</dependency>

		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
		</dependency>
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<dependency>
			<groupId>io.quarkus</groupId>
			<artifactId>quarkus-junit5</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.rest-assured</groupId>
			<artifactId>rest-assured</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<profiles>
		<!--
			Default build (no -P): standalone uber jar (target/quarkus-secure-field-0.0.1-runner.jar) and, via nested build
			of the lambda profile, the Lambda package (target/lambda/function.zip).  Skip the Lambda part with -Dlambda.skip.
			The Lambda needs a separate Quarkus build as quarkus-amazon-lambda-http replaces the HTTP server.
		-->
		<profile>
			<id>standalone</id>
			<activation>
				<!-- deactivated automatically when -Plambda is given, so the nested build does not recurse -->
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<plugins>

					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>create-invoker-dir</id>
								<phase>package</phase>
								<configuration>
									<target>
										<mkdir dir="${project.build.directory}/invoker-reports"/>
									</target>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>

					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-invoker-plugin</artifactId>
						<executions>
							<execution>
								<id>build-lambda</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<skipInvocation>${lambda.skip}</skipInvocation>
									<projectsDirectory>${project.basedir}</projectsDirectory>
									<reportsDirectory>${project.build.directory}/invoker-reports</reportsDirectory>
									<pomIncludes>
										<pomInclude>pom.xml</pomInclude>
									</pomIncludes>
									<goals>
										<goal>package</goal>
									</goals>
									<profiles>
										<profile>lambda</profile>
									</profiles>
									<properties>
										<!-- same code, already tested by the outer build -->
										<skipTests>true</skipTests>
									</properties>
									<streamLogs>true</streamLogs>
									<noLog>true</noLog>
									<disableReports>true</disableReports>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			AWS Lambda behind API Gateway HTTP API (payload v2), only:  mvn package -Plambda
			Produces target/lambda/function.zip, handler (provided by the extension): io.quarkus.amazon.lambda.runtime.QuarkusStreamHandler::handleRequest
			Deploy: npx serverless deploy  (serverless.yml)  or  sam deploy -g -t src/lambda/aws/template.yaml
		-->
		<profile>
			<id>lambda</id>
			<properties>
				<quarkus.package.jar.type>legacy-jar</quarkus.package.jar.type>
			</properties>
			<build>
				<!-- separate output, so it does not clash with the standalone build -->
				<directory>${project.basedir}/target/lambda</directory>
			</build>
			<dependencies>
				<dependency>
					<groupId>io.quarkus</groupId>
					<artifactId>quarkus-amazon-lambda-http</artifactId>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
